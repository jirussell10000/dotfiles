"vi compatability
set nocompatible

"makes it easy to read code via vim 
syntax on
set modelines=0

"line numbers
set number

"line numbers relative to the cursor location
set relativenumber
set encoding=utf-8
set wrap

set tabstop=4
set shiftwidth=2
set softtabstop=2
set autoindent
set copyindent
set expandtab
set noshiftround

set hlsearch
set incsearch
set showmatch
set smartcase

set hidden
set ttyfast
set laststatus=2

"turn off showcmd if terminal is slow
set showcmd
set background=dark
